{
  "name": "core-cut-erp",
  "private": true,
  "version": "1.0.0",
  "description": "Core Cut ERP — gestão integrada para marcenaria industrial",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "npm run db:check && npm run dev",
    "dev:web": "vite",
    "dev:api": "node --watch backend/server.mjs",
    "billing:check": "node scripts/billing-check.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "db:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-local-postgres.ps1",
    "db:reset": "node scripts/reset-local-postgres.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "start": "node backend/server.mjs",
    "prebuild": "npm run extension:package",
    "build": "tsc -b && vite build && node scripts/mark-private-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --no-warnings --test backend/test/*.test.mjs",
    "test:ui": "node scripts/smoke-ui.mjs",
    "catalog:export": "node scripts/export-leo-catalog.mjs",
    "extension:package": "node --no-warnings scripts/package-extension.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jost": "^5.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
