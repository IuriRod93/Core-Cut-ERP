# Variáveis opcionais do servidor (todas têm valor padrão)
# PORT=4400
# HOST=0.0.0.0
# ARCOPLAN_DATA_DIR=./backend/data
# ARCOPLAN_LOG=1
# ARCOPLAN_ADMIN_PASSWORD=arcoplan123
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/core_cut_erp
# PGPOOL_MAX=10
# DATABASE_IMPORT_JSON=0
# APP_URL=http://localhost:5174
# --- Cobrança (Mercado Pago) ---
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...   # Access Token da aplicação (produção ou usuário de teste)
# MERCADOPAGO_MODE=test                  # use com credenciais de usuário de teste (APP_USR-...)
# MERCADOPAGO_WEBHOOK_SECRET=...         # "Assinatura secreta" do webhook (painel Mercado Pago)
# ALLOW_SIMULATED_SIGNUP=0               # 1 libera / 0 bloqueia o botão "Simular pagamento" (padrão: só fora de produção)
# --- Aplicativo iPhone ---
# IOS_APP_URL=https://testflight.apple.com/join/XXXXXXXX   # link do TestFlight ou da App Store (aparece em /app)
